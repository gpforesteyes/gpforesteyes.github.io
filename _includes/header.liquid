<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
        {% if site.title == 'blank' %}
          {% if site.first_name %}
            <span class="font-weight-bold">
              {{- site.first_name -}}
            </span>
          {% endif %}
          {% if site.middle_name %}
            {{- site.middle_name -}}
          {% endif %}
          {% if site.last_name %}
            {{- site.last_name -}}
          {% endif %}
        {% else %}
          {{- site.title -}}
        {% endif %}
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {%- comment -%} Map permalink to an i18n key so JS can swap titles {%- endcomment -%}
              {%- assign i18n_key = '' -%}
              {%- case p.permalink -%}
                {%- when '/about/' -%}{%- assign i18n_key = 'nav.about' -%}
                {%- when '/publications/' -%}{%- assign i18n_key = 'nav.publications' -%}
                {%- when '/projects/' -%}{%- assign i18n_key = 'nav.projects' -%}
                {%- when '/books/' -%}{%- assign i18n_key = 'nav.books' -%}
                {%- when '/people/' -%}{%- assign i18n_key = 'nav.team' -%}
                {%- when '/news/' -%}{%- assign i18n_key = 'nav.news' -%}
                {%- when '/blog/' -%}{%- assign i18n_key = 'nav.blog' -%}
                {%- when '/cv/' -%}{%- assign i18n_key = 'nav.cv' -%}
                {%- when '/teaching/' -%}{%- assign i18n_key = 'nav.teaching' -%}
                {%- when '/repositories/' -%}{%- assign i18n_key = 'nav.repositories' -%}
              {%- endcase -%}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    <span{% if i18n_key != '' %} data-i18n="{{ i18n_key }}"{% endif %}>{{- p.title -}}</span>
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        {%- assign child_i18n_key = '' -%}
                        {%- case child.permalink -%}
                          {%- when '/about/' -%}{%- assign child_i18n_key = 'nav.about' -%}
                          {%- when '/publications/' -%}{%- assign child_i18n_key = 'nav.publications' -%}
                          {%- when '/projects/' -%}{%- assign child_i18n_key = 'nav.projects' -%}
                          {%- when '/books/' -%}{%- assign child_i18n_key = 'nav.books' -%}
                          {%- when '/people/' -%}{%- assign child_i18n_key = 'nav.team' -%}
                          {%- when '/news/' -%}{%- assign child_i18n_key = 'nav.news' -%}
                          {%- when '/blog/' -%}{%- assign child_i18n_key = 'nav.blog' -%}
                          {%- when '/cv/' -%}{%- assign child_i18n_key = 'nav.cv' -%}
                          {%- when '/teaching/' -%}{%- assign child_i18n_key = 'nav.teaching' -%}
                          {%- when '/repositories/' -%}{%- assign child_i18n_key = 'nav.repositories' -%}
                        {%- endcase -%}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                          {% if child_i18n_key != '' %}data-i18n="{{ child_i18n_key }}"{% endif %}
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    <span{% if i18n_key != '' %} data-i18n="{{ i18n_key }}"{% endif %}>{{- p.title -}}</span>
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
          <!-- Toggle language (PT-BR / EN) -->
          <li class="toggle-container">
            <button
              id="lang-toggle"
              type="button"
              title="Mudar idioma / Switch language"
              aria-label="Mudar idioma / Switch language"
              data-i18n-title="lang.toggle.title"
            >
              <span class="lang-flag lang-flag-pt" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 20">
                  <rect width="28" height="20" fill="#009C3B"/>
                  <polygon points="14,2 26,10 14,18 2,10" fill="#FFDF00"/>
                  <circle cx="14" cy="10" r="4" fill="#002776"/>
                </svg>
              </span>
              <span class="lang-flag lang-flag-en" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 20">
                  <rect width="28" height="20" fill="#B22234"/>
                  <g fill="#fff">
                    <rect y="1.54" width="28" height="1.54"/>
                    <rect y="4.62" width="28" height="1.54"/>
                    <rect y="7.69" width="28" height="1.54"/>
                    <rect y="10.77" width="28" height="1.54"/>
                    <rect y="13.85" width="28" height="1.54"/>
                    <rect y="16.92" width="28" height="1.54"/>
                  </g>
                  <rect width="11.2" height="10.77" fill="#3C3B6E"/>
                </svg>
              </span>
              <span class="lang-code" data-i18n="lang.code">PT-BR</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
